# Anthropic API Key (for Claude model, used by Python backend)
ANTHROPIC_API_KEY=sk-ant-your-key-here



# Backend communication (shared secret between Next.js and Python backend)
BACKEND_SECRET=generate-a-shared-secret-here
BACKEND_URL=http://localhost:8001

# ChromaDB (used by Python backend)
CHROMA_URL=http://localhost:8000

# Arize AX
# Get these from https://app.arize.com/organizations/-/settings/space-api-keys
ARIZE_SPACE_ID=your-arize-space-id
ARIZE_API_KEY=your-arize-api-key
ARIZE_PROJECT_NAME=wonder-toys-langchain-py

# Evals — set EVAL_SECRET so npm run synthetic-requests works even when a dev
# server is already running (the running Next.js process and the harness must
# share this value, or traces are tagged userId=anonymous).
EVAL_SECRET=any-random-string
# EVAL_BASE_URL=http://localhost:3000