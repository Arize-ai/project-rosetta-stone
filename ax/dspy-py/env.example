# Anthropic API Key (for Claude model, used by Python backend)
ANTHROPIC_API_KEY=sk-ant-your-key-here



# Backend communication (shared secret between Next.js and Python backend)
BACKEND_SECRET=generate-a-shared-secret-here
BACKEND_URL=http://localhost:8001

# ChromaDB (used by Python backend)
CHROMA_URL=http://localhost:8000

# Arize AX
# Get these from https://app.arize.com
ARIZE_SPACE_ID=your-arize-space-id
ARIZE_API_KEY=your-arize-api-key
ARIZE_PROJECT_NAME=wonder-toys-dspy

# Evals — EVAL_SECRET is auto-generated per run by npm run synthetic-requests.
# Do NOT set it here; start.sh sources this file with `set -a` and would
# clobber the random secret exported by the eval harness, causing 401s.
