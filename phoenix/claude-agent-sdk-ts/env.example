# Anthropic API Key — the Claude Agent SDK drives Claude models via the bundled
# Claude Code binary, which authenticates with this key.
ANTHROPIC_API_KEY=sk-ant-your-key-here



# Optional bypass secret for non-browser evaluators / smoke tests.
# When set, requests carrying `x-eval-secret: <value>` skip sign-in.
EVAL_SECRET=

# Arize Phoenix Cloud (or self-hosted Phoenix) — base URL only, no /v1/traces suffix.
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com
PHOENIX_API_KEY=your-phoenix-api-key
PHOENIX_PROJECT_NAME=wonder-toys-claude-agent-sdk-ts
